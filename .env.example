# Copy to server/.env for local dev. In production set these in your host's dashboard.
DATABASE_URL=postgres://equaroots:equaroots@localhost:5432/equaroots
APP_BASE_URL=http://localhost:8080
SESSION_SECRET=change-me-to-a-long-random-string

# Google OAuth (Google Cloud Console → Credentials → OAuth client ID → Web application)
# Authorised JavaScript origin: your APP_BASE_URL
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional: only allow this Workspace domain (admins are always allowed)
GOOGLE_ALLOWED_DOMAIN=

ADMIN_EMAILS=darshan.hy1722@gmail.com,shweta.singh.533@gmail.com

# Paste the same value into Cal.id → Settings → Developer → Webhooks → Secret
CAL_WEBHOOK_SECRET=

# Email (unset → emails are written to server/data/outbox instead of sent)
SENDGRID_API_KEY=
EMAIL_FROM=EquaRoots <care@equaroots.com>

# Private S3-compatible bucket for PDFs (unset → local disk + signed links)
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=
STORAGE_REGION=auto

# Local development only — enables passwordless email login. NEVER in production.
AUTH_DEV_LOGIN=false
